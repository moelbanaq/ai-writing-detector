---
import App from '../App.tsx';
import '../App.css';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags & SEO Title -->
    <title>Free AI Writing Detector for Scientific Research & Academic Papers | Word & PDF Checker</title>
    <meta name="title" content="Free AI Writing Detector for Scientific Research & Academic Papers | Word & PDF Checker" />
    <meta
      name="description"
      content="100% Free Journal-Grade AI Writing Forensic Detector for scientific manuscripts, academic theses, dissertations, and research papers. Supports Word (.docx), PDF (.pdf), and direct text uploads. Detects ChatGPT, Claude, and Gemini with Bayesian multi-signal calibration."
    />

    <!-- Comprehensive Academic & Scientific Keywords for Maximum Search Coverage -->
    <meta
      name="keywords"
      content="
      AI detector, free AI detector, AI writing detector, scientific paper AI detector, research paper AI checker, academic AI detector, journal manuscript AI detector, ChatGPT detector, Claude detector, Gemini detector, GPTZero free alternative, Turnitin AI detector free, free AI checker, AI essay checker, detect ChatGPT free, best free AI detector, check AI writing free, free online AI detector, word docx AI checker, pdf AI detector, upload pdf AI check, upload docx AI check, peer review AI detector, dissertation AI check, thesis AI detector, AI plagiarism checker, AI content detector, free AI content checker, undetectable AI checker, QuillBot detector, Grammarly AI check, AI text forensics, entropy AI detector, burstiness detector, perplexity checker, academic writing humanizer checker, Scopus paper AI detector, PubMed manuscript AI checker, Elsevier AI policy detector, Springer paper AI check, IEEE paper AI checker, college essay AI detector, student paper AI check, free AI detector no signup, 100% free AI detector, high accuracy AI detector, zero false positive AI detector, forensic stylometry, Zipf law text analysis, Flesch Kincaid grade level, AI writing report PDF
      "
    />

    <meta name="author" content="Scientific Research Forensic Team" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />
    <meta name="rating" content="General" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI Writing Forensic Analyzer" />
    <meta property="og:title" content="Free AI Writing Detector for Scientific Research (Word & PDF)" />
    <meta
      property="og:description"
      content="Analyze scientific manuscripts, research papers, and academic essays for AI-generated text. Supports Word (.docx), PDF (.pdf), and plain text with peer-review precision."
    />
    <meta property="og:image" content="/assets/og-preview.png" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free AI Writing Detector & Scientific Paper Checker (Word / PDF)" />
    <meta
      name="twitter:description"
      content="Free Journal-Grade AI Detector for Scientific Research, Theses, Dissertations, and Academic Manuscripts. Upload .docx and .pdf files."
    />

    <!-- Schema.org Structured Data (JSON-LD) for Search Engines & Rich Snippets -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "AI Writing Forensic Analyzer",
        "alternateName": ["Free AI Paper Detector", "Scientific AI Checker", "Academic AI Forensic Engine"],
        "applicationCategory": "AcademicApplication, EducationalApplication, UtilityApplication",
        "operatingSystem": "All (Web Browser, Chrome, Firefox, Safari, Edge)",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock"
        },
        "description": "Free scientific journal-grade AI writing forensic detection tool. Detects text generated by ChatGPT, Claude, and Gemini with statistical Bayesian calibration. Supports Word (.docx), PDF (.pdf), and plain text documents.",
        "featureList": [
          "100% Free - No signup, no credit card required",
          "Upload Word (.docx) and PDF (.pdf) documents directly",
          "9 Multi-signal statistical detectors (Entropy, Zipf's Law, Burstiness, Readability, Stylometric)",
          "Real-time usage analytics and transparency dashboard",
          "Exportable Color-Coded Academic PDF Audit Report",
          "Strict privacy: User texts are never stored in databases"
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "reviewCount": "1250"
        }
      }
    </script>

    <!-- Schema.org FAQ for Google Search Rich Snippets -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Is this AI writing detector free to use?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, this tool is 100% free for all researchers, university students, and authors with no paywalls, subscriptions, or account requirements."
            }
          },
          {
            "@type": "Question",
            "name": "Can I upload Word (.docx) and PDF (.pdf) documents directly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, the tool supports direct drag-and-drop and file uploads for Microsoft Word (.docx, .doc), PDF (.pdf), and plain text (.txt) files."
            }
          },
          {
            "@type": "Question",
            "name": "Which AI language models can this tool detect?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The forensic analyzer detects text generated or polished by OpenAI ChatGPT (GPT-4o, GPT-4, o1), Anthropic Claude (Sonnet, Opus), and Google Gemini via information-theoretic Shannon entropy, Zipf's Law deviations, sentence burstiness, and rhetorical pattern signatures."
            }
          }
        ]
      }
    </script>
  </head>
  <body>
    <noscript>
      <div style="padding: 20px; font-family: sans-serif; text-align: center;">
        <h1>Free AI Writing Detector for Scientific Research & Academic Papers</h1>
        <p>
          Specialized forensic tool for evaluating academic manuscripts, research papers, master's theses, and dissertations for AI-generated content (ChatGPT, Claude, Gemini).
          Supports direct file uploads for Word (.docx), PDF (.pdf), and text documents with comprehensive color-coded audit reports.
        </p>
      </div>
    </noscript>

    <div id="root">
      <App client:only="react" />
    </div>
  </body>
</html>
